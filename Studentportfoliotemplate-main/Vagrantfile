Vagrant.configure("2") do |config|
  config.vm.box = "eurolinux-vagrant/centos-stream-9"

  config.vm.hostname = "ymb-zone-b-dev"

  config.vm.network "private_network",
    ip: "192.168.56.13"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    yum install httpd wget unzip -y
    systemctl enable --now httpd

    cd /tmp
    rm -rf ymb-portfolio
    mkdir ymb-portfolio
    cd ymb-portfolio

    wget https://github.com/tanishaleo/COMP-4001-YMB-Zone-B/archive/refs/heads/main.zip -O main.zip

    unzip -o main.zip

    rm -rf /var/www/html/*

    cp -r COMP-4001-YMB-Zone-B-main/Studentportfoliotemplate-main/* /var/www/html/

    echo "Provisioned on: $(date)" > /var/www/html/status.txt

    systemctl restart httpd
  SHELL
end